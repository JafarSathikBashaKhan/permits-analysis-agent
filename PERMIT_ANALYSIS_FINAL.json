  "loginFlow": {
    "type": "Microsoft Azure AD OAuth (B2C)",
    "steps": [
      "1. Enter username/email on app login page (id: txt_username, class: signInBtn)",
      "2. Redirected to login.microsoftonline.com - enter email",
      "3. Enter Microsoft password",
      "4. 'Let's keep your account secure' MFA prompt → click Next (input[type=submit])",
      "5. mysignins.microsoft.com/register → wait ~7s for React → click 'Skip setup' button",
      "6. SAS/ProcessAuth redirect chain → click Yes on 'Stay signed in?' (KMSI)",
      "7. Redirected back to app"
    ]
  },
