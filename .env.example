# ==============================================================================
# Local environment file for the Permits Analysis Agent
# ==============================================================================
# This file is git-ignored (see .gitignore). Do NOT commit real credentials.
#
# 1) GitHub PAT — used to clone / read private Marston repositories such as
#    MNPS-Permission-UI, MNPS-Permission-API, etc.
#    Create one at: https://github.com/settings/tokens
#    Scopes required: repo (Full control of private repositories)
#
GITHUB_PAT=

# Optional: pin the org / repo the agent should read from.
# Example values shown; edit to match your actual repo path.
GITHUB_ORG=Marston-Holdings
GITHUB_REPO=MNPS-Permission-UI
GITHUB_REF=main

# ==============================================================================
# NPS Backoffice test environment (used by exploration scripts)
